<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview centrado. Su tamaño (lado del cuadrado o rect 9:16) lo fija la
         Activity con PreviewFraming según el modo, así el fondo negro del root
         queda visible como barras laterales (pillarbox) en el modo 9:16. El
         padre recorta al preview cuando este desborda (modo 1:1 que llena). El
         scaleType fillCenter llena ese rect con la cámara sin deformar. Este
         encuadre es SOLO de presentación: no toca la captura. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewfinder_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:scaleType="fillCenter" />

    <!-- Botón compacto de encuadre. Va abajo y centrado para no tapar la cara
         (que queda al centro); su propio texto (1:1 / 9:16) es el indicador
         discreto del modo activo. Tamaño pensado para la cover de ~3.4". -->
    <Button
        android:id="@+id/viewfinder_frame_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/preview_frame_toggle_background"
        android:contentDescription="@string/viewfinder_frame_toggle_description"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="@string/viewfinder_frame_square"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <!-- Estados de error (permiso denegado, cámara no disponible). Oculto
         mientras el visor funciona. -->
    <TextView
        android:id="@+id/viewfinder_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
